# ---------------------------------------------------------------
# Kids Area & Nursery ERP — environment template
# Copy to `.env` and fill in. NEVER commit `.env`.
# Only the publishable/anon key belongs here: it is safe for the
# browser BECAUSE Row Level Security protects every table.
# ---------------------------------------------------------------

# Supabase (client-side, publishable)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Application
VITE_APP_NAME=Kids Area & Nursery ERP
VITE_DEFAULT_LOCALE=ar
VITE_DEFAULT_CURRENCY=EGP
VITE_DEFAULT_TIMEZONE=Africa/Cairo

# ---------------------------------------------------------------
# Server-side only — used by scripts/tests/cron. NEVER prefix these
# with VITE_ and never ship them to the browser.
# ---------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=NOT_FOR_THE_BROWSER
SUPABASE_DB_PASSWORD=NOT_FOR_THE_BROWSER

# Bootstrap admin (used only by scripts/bootstrap-admin.mjs)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ON_FIRST_LOGIN
